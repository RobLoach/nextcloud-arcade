  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "vite build",
    "cores": "build/cores.sh",
    "dev": "vite build --mode development",
    "l10n:extract": "php build/translationtool.phar create-pot-files",
    "postcores": "build/check-core-licences.sh",
    "test": "npm run build",
    "test:js": "vitest run",
    "watch": "vite build --mode development --watch"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.51.0": true
  },
  "devDependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/files": "^4.1.1",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vite-config": "^2.5.4",
    "happy-dom": "^21.0.4",
    "nostalgist": "0.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nextcloud/dialogs": "^7.6.0",
    "fflate": "^0.8.3"
  }
}

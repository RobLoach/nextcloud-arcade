<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>arcade</id>
	<name>Arcade</name>
	<summary>Play retro games from your files</summary>
	<description><![CDATA[Play retro console games straight from your NextCloud files.

Arcade runs the RetroArch libretro cores in the browser, so nothing is uploaded anywhere else. Seventeen systems are covered, from ColecoVision to the PlayStation, with a games library you can browse by keyboard, mouse, touch or gamepad.

The library carries box art, play statistics, save states, screenshots, battery saves and BIOS handling, rewind and run-ahead, and configurable keys — all kept in folders of your own choosing. ROMs stay ordinary files: they open in the Files app and its viewer, carry an Arcade tab in the sidebar, take collaborative tags as library filters, show their box art as previews, and what you play lands in your Activity stream.]]></description>
	<version>0.39.8</version>
	<licence>AGPL-3.0-or-later</licence>
	<author homepage="https://robloach.net">Rob Loach</author>
	<namespace>Arcade</namespace>
	<!--
		remote.php loads only apps of these types, and every upload goes
		through it. Without this the app is not booted while a ROM is being
		written, its mimetypes are never registered, and the file is stored
		as application/octet-stream, which the Viewer has no player for.
	-->
	<types>
		<filesystem/>
	</types>
	<documentation>
		<user>https://github.com/robloach/nextcloud-arcade/blob/master/docs/usage.md</user>
		<admin>https://github.com/robloach/nextcloud-arcade/blob/master/docs/settings.md</admin>
		<developer>https://github.com/robloach/nextcloud-arcade/blob/master/docs/development.md</developer>
	</documentation>
	<category>games</category>
	<category>multimedia</category>
	<website>https://github.com/robloach/nextcloud-arcade</website>
	<discussion>https://github.com/robloach/nextcloud-arcade/discussions</discussion>
	<bugs>https://github.com/robloach/nextcloud-arcade/issues</bugs>
	<repository type="git">https://github.com/robloach/nextcloud-arcade.git</repository>
	<screenshot small-thumbnail="https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/img/screenshot-thumbnail.jpg">https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/img/screenshot.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/screenshots/game.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/screenshots/games-library.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/screenshots/games-list.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/screenshots/configuration.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/screenshots/administration.png</screenshot>
	<dependencies>
		<php min-version="8.3"/>
		<nextcloud min-version="34" max-version="35"/>
	</dependencies>
	<repair-steps>
		<post-migration>
			<step>OCA\Arcade\Migration\RegisterMimeTypes</step>
			<step>OCA\Arcade\Migration\RegisterMetadata</step>
			<step>OCA\Arcade\Migration\ConvertLegacyStorage</step>
		</post-migration>
		<install>
			<step>OCA\Arcade\Migration\RegisterMimeTypes</step>
			<step>OCA\Arcade\Migration\RegisterMetadata</step>
		</install>
		<uninstall>
			<step>OCA\Arcade\Migration\UninstallCleanup</step>
		</uninstall>
	</repair-steps>
	<commands>
		<command>OCA\Arcade\Command\Cleanup</command>
		<command>OCA\Arcade\Command\Uninstall</command>
		<command>OCA\Arcade\Command\Bios</command>
		<command>OCA\Arcade\Command\Status</command>
	</commands>
	<settings>
		<admin>OCA\Arcade\Settings\Admin</admin>
		<admin-section>OCA\Arcade\Settings\AdminSection</admin-section>
		<personal>OCA\Arcade\Settings\Personal</personal>
		<personal-section>OCA\Arcade\Settings\PersonalSection</personal-section>
	</settings>
	<activity>
		<settings>
			<setting>OCA\Arcade\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\Arcade\Activity\Provider</provider>
		</providers>
	</activity>
	<navigations>
		<navigation>
			<id>arcade</id>
			<name>Arcade</name>
			<route>arcade.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>

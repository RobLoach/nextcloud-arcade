/.idea/
/*.iml

/vendor/
/vendor-bin/*/vendor/

/.php-cs-fixer.cache
/tests/.phpunit.cache
/.psalm-cache/

/node_modules/

# The bundles are committed, their source maps are not: they are only
# useful while developing and weigh more than the bundles themselves.
/js/*.map

# Extracted cores from `npm run cores`. Only the default core for each
# supported system (see lib/CoreMap.php) and the license are committed.
/img/cores/*
